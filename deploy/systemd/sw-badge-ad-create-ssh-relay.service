[Unit]
Description=StumpfWorks Identity local SSH relay for AD Create
After=network-online.target
ConditionPathExists=/etc/stumpfworks-badge-create-relay/enabled

[Service]
Type=simple
User=swbadge-create-relay
Group=swbadge-create-relay
UMask=0077
ExecStart=/usr/local/libexec/stumpfworks-badge/ad-create-ssh-relay -mode login -config /etc/stumpfworks-badge-create-relay/login.json
TimeoutStopSec=40s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
ReadWritePaths=/run/stumpfworks-badge-create-relay
